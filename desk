#!/bin/sh
# Use the actual interpreter, not a relocated venv entry-point shebang.
DESK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${DESK_PYTHON:-}" ]; then
  exec "$DESK_PYTHON" "$DESK_ROOT/scripts/desk.py" "$@"
elif [ -x "$DESK_ROOT/.venv/bin/python" ]; then
  exec "$DESK_ROOT/.venv/bin/python" "$DESK_ROOT/scripts/desk.py" "$@"
else
  exec python3 "$DESK_ROOT/scripts/desk.py" "$@"
fi
