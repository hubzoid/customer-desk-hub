# Point the desk at the local fake Zoho Desk (a test double on loopback).
# These are the fake server's own fixed test values, not real credentials.
# Copy the lines into .env, then start:  python workflows/lib/customer_desk/helpdesk/fake_zoho.py --port 8724 \
#   --webhook-url http://127.0.0.1:8721/webhooks/<hub folder name>/zoho-desk
DESK_LOOPBACK_ONLY=1
ZOHO_DESK_API_BASE=http://127.0.0.1:8724/api/v1
ZOHO_DESK_ACCOUNTS_BASE=http://127.0.0.1:8724
ZOHO_DESK_CLIENT_ID=read-client
ZOHO_DESK_CLIENT_SECRET=read-secret
ZOHO_DESK_REFRESH_TOKEN=read-refresh
ZOHO_DESK_WRITE_CLIENT_ID=write-client
ZOHO_DESK_WRITE_CLIENT_SECRET=write-secret
ZOHO_DESK_WRITE_REFRESH_TOKEN=write-refresh
# Any value works for the fake. Use a long random one for a real Zoho Desk.
WEBHOOK_SECRET_ZOHO_DESK=fake-zoho-webhook-test-value
